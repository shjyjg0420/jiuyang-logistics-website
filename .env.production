# 生产环境配置
NODE_ENV=production
PORT=5000

# 数据库
MONGODB_URI=mongodb://mongo:27017/jiuyang-logistics
DB_NAME=jiuyang-logistics

# JWT
JWT_SECRET=change_this_to_a_strong_secret_key_in_production
JWT_EXPIRE=7d

# CORS
CORS_ORIGIN=https://jylogistics.com,https://www.jylogistics.com

# SSH
ENABLE_SSH=true
SSH_PORT=2222
SSH_HOST=0.0.0.0
SSH_PASSWORD=change_this_strong_password

# 日志
LOG_LEVEL=info
