{
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "dev:ssh": "ENABLE_SSH=true nodemon server.js",
    "ssh-only": "node ssh-server.js",
    "ssh-keygen": "bash scripts/generate-ssh-keys.sh",
    "test": "jest",
    "lint": "eslint .",
    "docker:build": "docker build -t jiuyang-logistics-server:latest .",
    "docker:run": "docker-compose up -d",
    "docker:stop": "docker-compose down",
    "docker:logs": "docker-compose logs -f app",
    "docker:clean": "docker-compose down -v"
  }
}
